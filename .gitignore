# ── ChurnIQ Model Files (too large / private) ──
churn_model_files/
*.pkl
*.zip
churn_model_package.zip

# ── Dataset (too large for GitHub) ──
*.csv
WA_Fn-UseC_-Telco-Customer-Churn.csv

# ── Byte-compiled / optimized / DLL files ──
__pycache__/
*.py[codz]
*$py.class
*.so

